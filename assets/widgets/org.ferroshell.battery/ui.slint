import { Shell, Theme } from "@ferroshell/api.slint";
import { Power } from "@ferroshell/services.slint";
import { PanelButton, Label, BatteryIcon, SunIcon } from "@ferroshell/controls.slint";

export component Widget inherits PanelButton {
    in property <string> instance-id;
    in property <bool> show-percentage: true;
    in property <bool> hide-without-battery: true;

    property <bool> shown: Power.available && (Power.has-battery || (!root.hide-without-battery && Power.displays.length > 0));
    visible: root.shown;
    max-width: root.shown ? 1000px : 0px;
    max-height: root.shown ? 1000px : 0px;
    horizontal-stretch: 0;
    content-padding: root.shown ? 6px : 0px;
    accessible-role: button;
    accessible-label: Power.has-battery ? "Battery " + Power.percent + "%, " + Power.status : "Brightness";

    clicked => {
        Shell.invoke("popup", root.instance-id + "|" + (self.absolute-position.x / 1px) + "," + (self.absolute-position.y / 1px)
            + "," + (self.width / 1px) + "," + (self.height / 1px));
    }
    // Scrolling changes the first screen's brightness, like Plasma's battery applet.
    wheel: Power.displays.length > 0;
    scrolled(n) => {
        Power.set-brightness(Power.displays[0].id, max(0, min(100, Power.displays[0].brightness + n * 5)));
    }

    if root.shown && Power.has-battery: BatteryIcon {
        y: (parent.height - self.height) / 2;
        percent: Power.percent;
        charging: Power.charging;
        width: Theme.icon-size * 0.9;
        height: self.width * 0.55;
    }
    if root.shown && !Power.has-battery: SunIcon {
        width: Theme.icon-size * 0.8;
        height: self.width;
    }
    if root.shown && Power.has-battery && root.show-percentage && !Shell.vertical: Label {
        text: Power.percent + "%";
    }
}
