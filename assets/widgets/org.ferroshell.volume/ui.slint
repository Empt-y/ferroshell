import { Shell, Theme } from "@ferroshell/api.slint";
import { Audio } from "@ferroshell/services.slint";
import { PanelButton, Label, SpeakerIcon } from "@ferroshell/controls.slint";

export component Widget inherits PanelButton {
    in property <string> instance-id;
    in property <int> scroll-step: 5;
    in property <bool> show-percentage: false;

    horizontal-stretch: 0;
    content-padding: 6px;
    opacity: Audio.available ? 1 : 0.5;
    accessible-role: button;
    accessible-label: Audio.muted ? "Volume, muted" : "Volume " + round(Audio.volume) + "%";

    clicked => {
        Shell.invoke("popup", root.instance-id + "|" + (self.absolute-position.x / 1px) + "," + (self.absolute-position.y / 1px)
            + "," + (self.width / 1px) + "," + (self.height / 1px));
    }
    middle-clicked => { Audio.set-muted(!Audio.muted); }
    wheel: Audio.available;
    scrolled(n) => { Audio.set-volume(max(0, min(100, Audio.volume + n * root.scroll-step))); }

    SpeakerIcon {
        level: Audio.volume;
        muted: Audio.muted || !Audio.available;
        width: Theme.icon-size * 0.8;
        height: self.width;
    }
    if root.show-percentage && !Shell.vertical: Label {
        text: Audio.muted ? "Muted" : round(Audio.volume) + "%";
    }
}
