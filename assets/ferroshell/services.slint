// Ferroshell system services, for applets and your own widgets.
//
//     import { Audio, Media } from "@ferroshell/services.slint";
//
// A widget has to ask for the services it reads in its widget.toml:
//
//     services = ["audio", "media"]
//
// The shell only runs a service while some widget on a panel asks for it. Until then (or
// if the service fails) `available` is false and everything else keeps its default.
// See docs/widget-api.md.

// An audio output or input device.
export struct AudioDevice {
    id: string,
    name: string,
    // The Windows default device.
    default: bool,
}

// An app playing (or able to play) sound, with its own volume.
export struct AudioApp {
    // Process id; 0 is "System sounds".
    pid: int,
    name: string,
    icon: image,
    // 0-100
    volume: float,
    muted: bool,
    // Playing right now.
    active: bool,
}

// Service "audio".
export global Audio {
    in property <bool> available;
    // Default output, 0-100.
    in property <float> volume;
    in property <bool> muted;
    in property <string> output-name;
    in property <[AudioDevice]> outputs;
    // Default input (microphone); `has-input` is false without one.
    in property <bool> has-input;
    in property <float> input-volume;
    in property <bool> input-muted;
    in property <string> input-name;
    in property <[AudioDevice]> inputs;
    // Per-app volumes on the default output.
    in property <[AudioApp]> apps;

    callback set-volume(/* 0-100 */ float);
    callback set-muted(bool);
    callback set-input-volume(/* 0-100 */ float);
    callback set-input-muted(bool);
    // Make a device (from `outputs` or `inputs`) the Windows default.
    callback set-default-device(/* id */ string);
    callback set-app-volume(/* pid */ int, /* 0-100 */ float);
    callback set-app-muted(/* pid */ int, bool);
}

// Service "media": the current media session (Spotify, a browser tab, ...).
export global Media {
    in property <bool> available;
    // Something is playing or paused.
    in property <bool> has-session;
    in property <string> title;
    in property <string> artist;
    in property <string> album;
    // The app that's playing, and its icon when the shell knows it.
    in property <string> app-name;
    in property <image> app-icon;
    in property <image> art;
    in property <bool> has-art;
    in property <bool> playing;
    in property <bool> can-play-pause;
    in property <bool> can-next;
    in property <bool> can-previous;

    callback play-pause();
    callback next();
    callback previous();
}

// A Wi-Fi network from the last scan, or the one currently connected.
export struct WifiNetwork {
    ssid: string,
    // "Open", "WPA2-Personal", ...
    security: string,
    // A password is needed and no profile is saved for it yet.
    needs-password: bool,
    // 0-4
    bars: int,
    connected: bool,
    // A profile is already saved: connecting doesn't need a password.
    saved: bool,
}

// An active VPN (RAS) connection.
export struct VpnConnection {
    name: string,
}

// Service "network": Wi-Fi, Ethernet, overall connectivity, airplane mode and VPN status.
export global Network {
    in property <bool> available;
    // Wi-Fi hardware exists on this machine.
    in property <bool> wifi-present;
    in property <bool> wifi-enabled;
    in property <bool> airplane-mode;
    // Has some connectivity (even if only local/limited).
    in property <bool> connected;
    // Connected, but without full internet access.
    in property <bool> limited;
    // "wifi", "ethernet" or "none": the primary connection right now.
    in property <string> kind;
    in property <string> ssid;
    // 0-4, only meaningful while `kind == "wifi"`.
    in property <int> bars;
    in property <string> ethernet-name;
    in property <[WifiNetwork]> networks;
    in property <[VpnConnection]> vpns;
    // The last connect/forget attempt's error, if any ("" otherwise).
    in property <string> error;

    callback scan();
    // A saved (or open, unsaved) network.
    callback connect(/* ssid */ string);
    // An unsaved network that needs a password.
    callback connect-new(/* ssid */ string, /* password */ string);
    callback disconnect();
    callback forget(/* ssid */ string);
    callback set-wifi-enabled(bool);
    callback set-airplane-mode(bool);
    callback vpn-disconnect(/* name */ string);
}

// A paired Bluetooth device.
export struct BluetoothDevice {
    id: string,
    name: string,
    // "audio", "input", "phone", "computer", "wearable" or "other".
    kind: string,
    connected: bool,
    // Audio devices: `Bluetooth.connect`/`disconnect` work on it. Other kinds reconnect
    // by themselves when used.
    can-connect: bool,
    // 0-100, or -1 when Windows doesn't know.
    battery: int,
    // "Connected · 80%", "Paired", ...
    status: string,
}

// Service "bluetooth": the radio and paired devices.
export global Bluetooth {
    in property <bool> available;
    // This machine has a Bluetooth radio.
    in property <bool> present;
    in property <bool> enabled;
    in property <int> connected-count;
    in property <[BluetoothDevice]> devices;
    // The last action's error, if any ("" otherwise).
    in property <string> error;

    callback set-enabled(bool);
    callback connect(/* id */ string);
    callback disconnect(/* id */ string);
}

// A screen whose brightness can be changed.
export struct Display {
    id: string,
    name: string,
    // The laptop's own panel (otherwise an external monitor over DDC/CI).
    internal: bool,
    // 0-100
    brightness: float,
}

// Service "power": battery, power mode, energy saver and screen brightness.
export global Power {
    in property <bool> available;
    in property <bool> has-battery;
    // 0-100
    in property <int> percent;
    // 0-5 bars, for icons.
    in property <int> level;
    in property <bool> charging;
    in property <bool> on-ac;
    // "2 h 15 min left", "Charging · 45 min until full", "Fully charged", ...
    in property <string> status;
    // Battery wear (today's capacity vs. design), 0-100, or -1 when unknown.
    in property <int> health;
    // "efficiency", "balanced", "performance", or "custom" (e.g. an OEM overlay).
    in property <string> power-mode;
    // Power mode only applies on the Balanced power plan.
    in property <bool> mode-available;
    // "on", "off" or "unavailable" (plugged in).
    in property <string> energy-saver;
    in property <[Display]> displays;
    // The last action's error, if any ("" otherwise).
    in property <string> error;

    callback set-power-mode(/* "efficiency" | "balanced" | "performance" */ string);
    callback set-brightness(/* display id */ string, /* 0-100 */ float);
}
