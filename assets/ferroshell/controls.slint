// Building blocks for panel widgets that follow the active theme.
//
//     import { PanelButton, Label, DimLabel } from "@ferroshell/controls.slint";

import { Theme, Shell } from "api.slint";

// Themed text.
export component Label inherits Text {
    color: Theme.foreground;
    font-size: Theme.font-size;
    vertical-alignment: center;
    overflow: elide;
}

export component DimLabel inherits Label {
    color: Theme.foreground-dim;
    font-size: Theme.font-size * 0.85;
}

// A flat, themed button that fills the panel's thickness. Put content inside it; it is
// laid out horizontally with padding. Use `clicked`, `middle-clicked` and
// `right-clicked(x, y)` (position relative to the button).
//
// `indicator` marks the button along the panel's screen edge (e.g. "app is running"); with
// `active` it grows and uses the indicator colour. Its look is the theme's
// `indicator-style`, and hovering does the theme's `hover-effect`.
export component PanelButton inherits Rectangle {
    in property <bool> active;
    in property <bool> attention;
    in property <bool> indicator;
    in property <bool> enabled: true;
    in property <length> content-padding: 6px;
    out property <bool> hovered: touch.has-hover;
    out property <bool> pressed: touch.pressed;
    callback clicked();
    callback middle-clicked();
    callback double-clicked();
    callback right-clicked(/* x */ length, /* y */ length);
    // Mouse wheel over the button: +1 per notch up, -1 down. Only fires (and only stops the
    // wheel reaching what's behind) when `wheel` is true.
    in property <bool> wheel;
    callback scrolled(/* notches */ int);

    property <bool> hot: touch.has-hover && root.enabled;
    property <string> effect: Theme.hover-effect;
    property <string> style: Theme.indicator-style;
    property <length> along: Shell.vertical ? root.height : root.width;
    // Fade in when first shown (a task appearing, a widget being added).
    property <bool> appeared;
    init => { root.appeared = true; }
    opacity: root.appeared ? 1 : 0;
    animate opacity { duration: Theme.normal; easing: ease-out; }

    border-radius: Theme.radius;
    background: touch.pressed ? Theme.pressed
        : root.hot && root.effect != "underline" ? Theme.hover
        : root.active ? Theme.highlight
        : transparent;
    animate background { duration: Theme.fast; }
    drop-shadow-blur: root.hot && root.effect == "glow" ? max(6px, Theme.shadow-blur * 0.6) : 0;
    drop-shadow-color: Theme.glow;
    animate drop-shadow-blur { duration: Theme.normal; easing: ease-out; }

    // Content is centred on both axes; stretchy children (e.g. a title label) still fill.
    Rectangle {
        transform-scale: touch.pressed ? 0.9 : root.hot && root.effect == "lift" ? 1.12 : 1.0;
        animate transform-scale { duration: Theme.normal; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
        VerticalLayout {
            alignment: center;
            padding-left: root.content-padding;
            padding-right: root.content-padding;
            HorizontalLayout {
                spacing: 6px;
                alignment: center;
                @children
            }
        }
    }

    // Hover effect "underline": a bar that grows on the inner side (away from the indicator).
    if root.effect == "underline": Rectangle {
        property <length> len: root.hot ? root.along * 0.6 : 0;
        width: Shell.vertical ? 2px : self.len;
        height: Shell.vertical ? self.len : 2px;
        border-radius: 1px;
        background: Theme.accent;
        x: Shell.vertical ? (Shell.edge == "left" ? parent.width - 3px : 1px) : (parent.width - self.width) / 2;
        y: Shell.vertical ? (parent.height - self.height) / 2 : (Shell.edge == "top" ? parent.height - 3px : 1px);
        animate width, height { duration: Theme.normal; easing: ease-out; }
    }

    if root.indicator && !root.attention && root.style != "none": Rectangle {
        property <length> thick: root.style == "dot" ? Theme.indicator-size * 2.5
            : root.style == "pill" ? Theme.indicator-size * 1.5
            : Theme.indicator-size;
        property <length> len: root.style == "dot" ? (root.active ? self.thick * 3.5 : self.thick)
            : root.style == "pill" ? (root.active ? root.along * 0.55 : min(14px, root.along * 0.3))
            : (root.active ? min(20px, root.along - 8px) : 8px);
        width: Shell.vertical ? self.thick : self.len;
        height: Shell.vertical ? self.len : self.thick;
        border-radius: self.thick / 2;
        background: root.active ? Theme.indicator : Theme.foreground-dim;
        drop-shadow-blur: root.style == "glow" ? (root.active ? 10px : 5px) : 0;
        drop-shadow-color: root.active ? Theme.glow : Theme.foreground-dim.with-alpha(0.4);
        // Along the screen edge, like Plasma and Windows.
        x: Shell.vertical ? (Shell.edge == "left" ? 1px : parent.width - self.width - 1px) : (parent.width - self.width) / 2;
        y: Shell.vertical ? (parent.height - self.height) / 2 : (Shell.edge == "top" ? 1px : parent.height - self.height - 1px);
        animate width, height, background, drop-shadow-blur { duration: Theme.normal; easing: ease-out; }
    }

    // Attention: a pulsing bar along the screen edge.
    if root.attention: attention-bar := Rectangle {
        property <bool> pulse;
        Timer {
            interval: 750ms;
            running: Theme.animation-speed > 0;
            triggered => { attention-bar.pulse = !attention-bar.pulse; }
        }
        background: Theme.attention;
        border-radius: 1px;
        height: Shell.vertical ? parent.height - 8px : 3px;
        width: Shell.vertical ? 3px : parent.width - 8px;
        x: Shell.edge == "left" ? 0 : Shell.edge == "right" ? parent.width - self.width : 4px;
        y: Shell.edge == "top" ? 0 : Shell.edge == "bottom" ? parent.height - self.height : 4px;
        drop-shadow-blur: 6px;
        drop-shadow-color: Theme.attention.with-alpha(0.6);
        opacity: self.pulse ? 0.35 : 1;
        animate opacity { duration: 650ms; easing: ease-in-out; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
        scroll-event(e) => {
            if !root.wheel || e.delta-y == 0 {
                return reject;
            }
            root.scrolled(e.delta-y > 0 ? 1 : -1);
            accept
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.up {
                if e.button == PointerEventButton.middle {
                    root.middle-clicked();
                } else if e.button == PointerEventButton.right {
                    root.right-clicked(self.mouse-x, self.mouse-y);
                }
            }
        }
    }
}

// Plays the theme's `open-animation` on its content when `open` turns true: the shell
// shows a window with `open` false, then sets it (popups, the launcher, banners, the OSD).
// `from` is the side it slides in from: "below", "above", "left" or "right".
export component Reveal inherits Rectangle {
    in property <bool> open: true;
    in property <string> from: "below";
    property <string> style: Theme.open-animation;
    property <bool> on: root.open || root.style == "none";
    property <length> offset: 14px;
    opacity: root.on ? 1 : 0;
    transform-scale: root.on || root.style != "zoom" ? 1.0 : 0.94;
    animate opacity { duration: Theme.normal; easing: ease-out; }
    animate transform-scale { duration: Theme.slow; easing: cubic-bezier(0.2, 0.9, 0.3, 1.1); }
    Rectangle {
        x: root.on || root.style != "slide" ? 0 : root.from == "left" ? -root.offset : root.from == "right" ? root.offset : 0;
        y: root.on || root.style != "slide" ? 0 : root.from == "above" ? -root.offset : root.from == "below" ? root.offset : 0;
        width: parent.width;
        height: parent.height;
        animate x, y { duration: Theme.slow; easing: cubic-bezier(0.16, 1, 0.3, 1); }
        @children
    }
}

// Shown by the shell in place of a widget that failed to load. Hover shows the reason.
export component ErrorWidget inherits Rectangle {
    in property <string> widget-id;
    in property <string> message;
    border-radius: Theme.radius;
    background: touch.has-hover ? Theme.error.with-alpha(0.35) : Theme.error.with-alpha(0.2);
    animate background { duration: Theme.fast; }
    min-width: 28px;
    horizontal-stretch: 0;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 4px;
        alignment: center;
        Text {
            text: "!";
            color: Theme.error;
            font-weight: 800;
            font-size: Theme.font-size * 1.2;
            vertical-alignment: center;
        }
        if touch.has-hover: Text {
            text: root.widget-id + ": " + root.message;
            color: Theme.foreground;
            font-size: Theme.font-size * 0.85;
            vertical-alignment: center;
            max-width: 480px;
            overflow: elide;
        }
    }
    touch := TouchArea {}
}

// ---- Popup controls ------------------------------------------------------------------

// A horizontal slider from 0 to `maximum`. It reports every change through `changed` and
// never writes `value` itself, so `value` can stay bound to live data (e.g. Audio.volume)
// without the two fighting while the user drags. Scroll to nudge by `step`; arrow keys
// work when it has focus.
export component Slider inherits Rectangle {
    in property <float> value;
    in property <float> maximum: 100;
    in property <float> step: 5;
    in property <bool> enabled: true;
    out property <bool> dragging: touch.pressed;
    callback changed(float);

    property <float> drag-value;
    property <float> shown: touch.pressed ? root.drag-value : root.value;
    property <length> knob: 14px;

    min-width: 60px;
    height: 22px;
    horizontal-stretch: 1;
    opacity: root.enabled ? 1 : 0.5;

    function set-from(x: length) {
        root.drag-value = max(0, min(root.maximum, (x - root.knob / 2) / (root.width - root.knob) * root.maximum));
        root.changed(root.drag-value);
    }
    function nudge(by: float) {
        root.changed(max(0, min(root.maximum, root.value + by)));
    }

    // Track, then the filled part.
    Rectangle {
        x: root.knob / 2;
        width: parent.width - root.knob;
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.foreground-dim.with-alpha(0.3);
    }
    Rectangle {
        x: root.knob / 2;
        width: (parent.width - root.knob) * min(1, root.shown / max(root.maximum, 0.001));
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
        animate width { duration: touch.pressed ? 0ms : Theme.fast; }
    }
    Rectangle {
        property <length> size: touch.pressed ? root.knob + 4px : touch.has-hover || focus.has-focus ? root.knob + 2px : root.knob;
        x: (parent.width - root.knob) * min(1, root.shown / max(root.maximum, 0.001)) - (self.size - root.knob) / 2;
        y: (parent.height - self.height) / 2;
        width: self.size;
        height: self.size;
        border-radius: self.width / 2;
        drop-shadow-blur: 4px;
        drop-shadow-color: Theme.shadow;
        animate width, height { duration: Theme.fast; easing: ease-out; }
        animate x { duration: touch.pressed ? 0ms : Theme.fast; }
        background: touch.has-hover || focus.has-focus ? Theme.foreground : Theme.foreground.with-alpha(0.9);
        animate background { duration: Theme.fast; }
        border-width: focus.has-focus ? 2px : 0;
        border-color: Theme.accent;
    }
    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                focus.focus();
                root.set-from(self.mouse-x);
            }
        }
        moved => {
            if self.pressed {
                root.set-from(self.mouse-x);
            }
        }
        scroll-event(e) => {
            if e.delta-y > 0 {
                root.nudge(root.step);
            } else if e.delta-y < 0 {
                root.nudge(-root.step);
            }
            accept
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if e.text == Key.RightArrow || e.text == Key.UpArrow {
                root.nudge(root.step);
                return accept;
            }
            if e.text == Key.LeftArrow || e.text == Key.DownArrow {
                root.nudge(-root.step);
                return accept;
            }
            reject
        }
    }
}

// A small round, flat button for icons (mute, play, ...). Put the icon inside.
export component IconButton inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> checked;
    in property <string> tooltip;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: self.height / 2;
    background: !root.enabled ? transparent
        : touch.pressed ? Theme.pressed
        : touch.has-hover ? Theme.hover
        : root.checked ? Theme.highlight
        : transparent;
    animate background { duration: Theme.fast; }
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: root.tooltip;
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Rectangle {
        transform-scale: touch.pressed ? 0.86 : 1.0;
        animate transform-scale { duration: Theme.fast; easing: ease-out; }
        @children
    }
}

// A row in a popup list (a device, a network, ...): highlighted on hover, and marked when
// `selected`.
export component ListRow inherits Rectangle {
    in property <bool> selected;
    callback clicked();
    height: 34px;
    border-radius: Theme.radius;
    background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : root.selected ? Theme.highlight : transparent;
    animate background { duration: Theme.fast; }
    touch := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        @children
    }
}

// Section heading inside a popup.
export component Heading inherits Text {
    color: Theme.foreground-dim;
    font-size: Theme.font-size * 0.85;
    font-weight: 600;
    vertical-alignment: center;
}

// ---- Icons (vector, so they follow the theme's colours) --------------------------------

// Speaker with 0-3 sound waves for `level` (0-100), or a cross when `muted`.
export component SpeakerIcon inherits Rectangle {
    in property <float> level: 50;
    in property <bool> muted;
    in property <color> tint: Theme.foreground;
    width: 18px;
    height: 18px;
    Path {
        viewbox-width: 24;
        viewbox-height: 24;
        width: 100%;
        height: 100%;
        fill: root.tint;
        commands: "M3 9 L7 9 L12 4.5 L12 19.5 L7 15 L3 15 Z";
    }
    Path {
        viewbox-width: 24;
        viewbox-height: 24;
        width: 100%;
        height: 100%;
        stroke: root.tint;
        stroke-width: 1.8px;
        commands: root.muted ? "M16 9.5 L21 14.5 M21 9.5 L16 14.5"
            : root.level <= 0 ? ""
            : root.level < 34 ? "M15 10 Q16.5 12 15 14"
            : root.level < 67 ? "M15 10 Q16.5 12 15 14 M17.5 7.5 Q21 12 17.5 16.5"
            : "M15 10 Q16.5 12 15 14 M17.5 7.5 Q21 12 17.5 16.5 M20 5 Q25 12 20 19";
    }
}

// Microphone, struck through when `muted`.
export component MicIcon inherits Rectangle {
    in property <bool> muted;
    in property <color> tint: Theme.foreground;
    width: 18px;
    height: 18px;
    Path {
        viewbox-width: 24;
        viewbox-height: 24;
        width: 100%;
        height: 100%;
        stroke: root.tint;
        stroke-width: 1.8px;
        commands: "M9 5 A3 3 0 0 1 15 5 L15 11 A3 3 0 0 1 9 11 Z M5.5 11 A6.5 6.5 0 0 0 18.5 11 M12 17.5 L12 21 M8.5 21 L15.5 21"
            + (root.muted ? " M4 3 L20 21" : "");
    }
}

// Media transport icons: "play", "pause", "next" or "previous".
export component MediaIcon inherits Rectangle {
    in property <string> kind: "play";
    in property <color> tint: Theme.foreground;
    width: 16px;
    height: 16px;
    Path {
        viewbox-width: 24;
        viewbox-height: 24;
        width: 100%;
        height: 100%;
        fill: root.tint;
        commands: root.kind == "pause" ? "M6 4 L10 4 L10 20 L6 20 Z M14 4 L18 4 L18 20 L14 20 Z"
            : root.kind == "next" ? "M4 4 L15 12 L4 20 Z M16 4 L20 4 L20 20 L16 20 Z"
            : root.kind == "previous" ? "M20 4 L9 12 L20 20 Z M4 4 L8 4 L8 20 L4 20 Z"
            : "M6 3.5 L20 12 L6 20.5 Z";
    }
}

// Wi-Fi bars: `bars` (0-4) filled, the rest dim. `off` draws a slashed icon (radio disabled).
export component WifiIcon inherits Rectangle {
    in property <int> bars: 4;
    in property <bool> off;
    in property <color> tint: Theme.foreground;
    in property <color> dim: Theme.foreground-dim;
    width: 18px;
    height: 18px;
    for i in 4: Rectangle {
        property <int> level: i + 1;
        width: 3px;
        height: 3px + i * 3.2px;
        x: 1.5px + i * 4.3px;
        y: 17px - self.height;
        border-radius: 1px;
        background: root.off ? root.dim.with-alpha(0.4) : self.level <= root.bars ? root.tint : root.dim.with-alpha(0.4);
        animate background { duration: Theme.fast; }
    }
    if root.off: Path {
        viewbox-width: 24;
        viewbox-height: 24;
        width: 100%;
        height: 100%;
        stroke: root.tint;
        stroke-width: 2px;
        commands: "M2 2 L22 22";
    }
}

// A wired-connection icon (a plug), dim when `off`.
export component EthernetIcon inherits Rectangle {
    in property <bool> off;
    in property <color> tint: Theme.foreground;
    width: 18px;
    height: 18px;
    Path {
        viewbox-width: 24;
        viewbox-height: 24;
        width: 100%;
        height: 100%;
        stroke: root.off ? Theme.foreground-dim : root.tint;
        stroke-width: 1.8px;
        commands: "M8 2 L8 8 M16 2 L16 8 M5 8 L19 8 L19 13 A7 7 0 0 1 5 13 Z M12 20 L12 15";
    }
}

// The airplane-mode icon.
export component AirplaneIcon inherits Rectangle {
    in property <color> tint: Theme.foreground;
    width: 18px;
    height: 18px;
    Path {
        viewbox-width: 24;
        viewbox-height: 24;
        width: 100%;
        height: 100%;
        fill: root.tint;
        commands: "M21 15 L14 15 L14 21 L17 22 L17 23 L7 23 L7 22 L10 21 L10 15 L3 15 L3 12 L10 10 L10 3 A2 2 0 0 1 14 3 L14 10 L21 12 Z";
    }
}

// The Bluetooth rune; dim and struck through when `off`.
export component BluetoothIcon inherits Rectangle {
    in property <bool> off;
    in property <color> tint: Theme.foreground;
    width: 18px;
    height: 18px;
    Path {
        viewbox-width: 24;
        viewbox-height: 24;
        width: 100%;
        height: 100%;
        stroke: root.off ? Theme.foreground-dim : root.tint;
        stroke-width: 1.8px;
        commands: "M6.5 7 L17 16.5 L12 21.5 L12 2.5 L17 7.5 L6.5 17" + (root.off ? " M3 3 L21 21" : "");
    }
}

// Small line icons drawn as paths (the UI font lacks symbols like ✕ and ⟳):
// `kind` is "close", "refresh" or "arrow" (pointing right).
export component GlyphIcon inherits Rectangle {
    in property <string> kind: "close";
    in property <color> tint: Theme.foreground-dim;
    width: 12px;
    height: 12px;
    Path {
        viewbox-width: 24;
        viewbox-height: 24;
        width: 100%;
        height: 100%;
        stroke: root.tint;
        stroke-width: 1.8px;
        fill: transparent;
        commands: root.kind == "refresh" ? "M20 12 A8 8 0 1 1 17.7 6.3 M20 3 L20 8 L15 8"
            : root.kind == "arrow" ? "M4 12 L20 12 M13 5 L20 12 L13 19"
            : "M5 5 L19 19 M19 5 L5 19";
    }
}

// A bell, for notifications; a slash through it while `muted` (Do Not Disturb).
export component BellIcon inherits Rectangle {
    in property <bool> muted;
    in property <color> tint: Theme.foreground;
    width: 18px;
    height: 18px;
    Path {
        viewbox-width: 24;
        viewbox-height: 24;
        width: 100%;
        height: 100%;
        stroke: root.tint;
        stroke-width: 1.8px;
        commands: "M6 17 L6 11 A6 6 0 0 1 18 11 L18 17 L20 19 L4 19 Z M10 21.5 L14 21.5" + (root.muted ? " M3 3 L21 21" : "");
    }
}

// A sun, for brightness.
export component SunIcon inherits Rectangle {
    in property <color> tint: Theme.foreground;
    width: 18px;
    height: 18px;
    Path {
        viewbox-width: 24;
        viewbox-height: 24;
        width: 100%;
        height: 100%;
        stroke: root.tint;
        stroke-width: 1.8px;
        commands: "M8 12 A4 4 0 1 0 16 12 A4 4 0 1 0 8 12 M12 2 L12 4.5 M12 19.5 L12 22 M2 12 L4.5 12 M19.5 12 L22 12 M4.9 4.9 L6.7 6.7 M17.3 17.3 L19.1 19.1 M4.9 19.1 L6.7 17.3 M17.3 6.7 L19.1 4.9";
    }
}

// A horizontal battery filled to `percent` (0-100), with a bolt while `charging`. Turns the
// theme's error colour when nearly empty and not charging.
// A battery that tells its three states apart:
//   on battery          a plain battery (pulsing red when nearly empty)
//   charging            a green fill with a light sweeping across it, and a pulsing bolt
//   plugged in, idle    a steady plug (full, or held below full by a charge limit)
// All motion stops when the theme's `animation-speed` is 0.
export component BatteryIcon inherits Rectangle {
    in property <float> percent: 100;
    in property <bool> charging;
    // On mains power (charging or not). With `charging` false this is "plugged in, idle".
    in property <bool> on-ac;
    in property <color> tint: Theme.foreground;
    property <bool> low: root.percent <= 10 && !root.on-ac;
    property <bool> plugged-idle: root.on-ac && !root.charging;
    property <color> fill: root.low ? Theme.error : root.charging ? Theme.charging : root.tint;
    property <bool> moving: Theme.animation-speed > 0;
    // Flips every 700 ms while something is animating; each flip is a normal animation. (A
    // flag set once with an endless animation on it doesn't reliably start, and keeps
    // bouncing between its last two values when its target changes.)
    property <bool> beat;
    Timer {
        interval: 700ms;
        running: root.moving && (root.low || root.charging);
        triggered => { root.beat = !root.beat; }
    }
    width: 22px;
    height: 12px;
    // Body.
    body := Rectangle {
        x: 0;
        width: parent.width - 2px;
        height: parent.height;
        border-radius: 2.5px;
        border-width: 1.2px;
        border-color: root.fill;
        animate border-color { duration: Theme.normal; }
        fillbar := Rectangle {
            x: 2px;
            y: 2px;
            height: parent.height - 4px;
            width: max(0px, (parent.width - 4px) * min(100, root.percent) / 100);
            border-radius: 1px;
            background: root.fill;
            clip: true;
            animate background { duration: Theme.normal; }
            animate width { duration: Theme.slow; easing: ease-out; }
            // Charging: a soft light travels across the fill, over and over.
            if root.charging && root.moving: Rectangle {
                width: 6px;
                height: parent.height;
                x: root.beat ? parent.width : -self.width;
                background: @linear-gradient(90deg, #ffffff00 0%, #ffffffa0 50%, #ffffff00 100%);
                animate x { duration: 650ms; easing: ease-in-out; }
            }
        }
    }
    // Terminal nub.
    Rectangle {
        x: parent.width - 2px;
        y: (parent.height - self.height) / 2;
        width: 2px;
        height: parent.height * 0.45;
        border-radius: 1px;
        background: root.fill;
        animate background { duration: Theme.normal; }
    }
    // Nearly empty on battery: the battery breathes. A fading cover that exists only while
    // low, with its own start: an endless animation on a property whose target changes
    // would keep bouncing between the old and new value after the state changes.
    if root.low && root.moving: Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 2.5px;
        background: Theme.panel-background.with-alpha(1);
        opacity: root.beat ? 0.6 : 0;
        animate opacity { duration: 600ms; easing: ease-in-out; }
    }
    // Charging: a bolt that pulses.
    if root.charging: Path {
        x: (body.width - self.width) / 2;
        width: 10px;
        height: parent.height;
        viewbox-width: 10;
        viewbox-height: 14;
        fill: Theme.accent-foreground;
        stroke: Theme.panel-background;
        stroke-width: 1px;
        commands: "M6 0 L1 8 L4.5 8 L3.5 14 L9 5.5 L5.5 5.5 Z";
        opacity: root.moving && root.beat ? 0.45 : 1;
        animate opacity { duration: 600ms; easing: ease-in-out; }
    }
    // Plugged in but not charging: a plug, steady.
    if root.plugged-idle: Path {
        x: (body.width - self.width) / 2;
        width: 9px;
        height: parent.height;
        viewbox-width: 10;
        viewbox-height: 14;
        fill: transparent;
        // The panel's own colour, opaque: it reads against the fill on dark and light themes.
        stroke: Theme.panel-background.with-alpha(1);
        stroke-width: 1.7px;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: "M3 0.8 V4 M7 0.8 V4 M1.2 4 H8.8 V6.8 A3.8 3.8 0 0 1 1.2 6.8 Z M5 10.6 V13.2";
    }
}

// A pill switch: on (accent) or off. Commits on click, unlike Slider — a switch has no
// intermediate state to fight over with live data.
export component Toggle inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 38px;
    height: 22px;
    border-radius: self.height / 2;
    background: !root.enabled ? Theme.foreground-dim.with-alpha(0.2) : root.checked ? Theme.accent : Theme.foreground-dim.with-alpha(0.35);
    opacity: root.enabled ? 1 : 0.6;
    animate background { duration: Theme.normal; }
    Rectangle {
        width: touch.pressed ? 21px : 16px;
        height: 16px;
        x: root.checked ? parent.width - self.width - 3px : 3px;
        y: (parent.height - self.height) / 2;
        border-radius: self.height / 2;
        background: root.checked ? Theme.accent-foreground : white;
        animate background { duration: Theme.fast; }
        drop-shadow-blur: 3px;
        drop-shadow-color: Theme.shadow;
        animate x, width { duration: Theme.normal; easing: cubic-bezier(0.34, 1.4, 0.64, 1); }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.toggled(!root.checked); }
    }
}